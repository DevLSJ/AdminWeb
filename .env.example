# ─────────────────────────────────────────────
# 서버 /home/dguard/dguard-kms/.env 파일 (권한 600)
# 이 파일을 .env 로 복사 후 실제 값으로 채울 것
# ─────────────────────────────────────────────

# Docker Hub 계정
DOCKER_USERNAME=your_dockerhub_username

# 배포 이미지 태그 (GitHub Actions에서 자동 주입)
IMAGE_TAG=latest

# PostgreSQL
DB_NAME=dguard_kms
DB_USER=dguard
DB_PASSWORD=change_me_strong_password

# 마스터 패스프레이즈 (20자 이상 권장)
KMS_MASTER_PASSPHRASE=change_me_strong_passphrase_20chars

# 무결성 HMAC 키
INTEGRITY_HMAC_KEY=change_me_hmac_key

# JWT 시크릿
JWT_SECRET=change_me_jwt_secret

# DDL 전략 (초기: create, 이후: validate)
DDL_AUTO=create
