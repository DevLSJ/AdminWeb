# ─────────────────────────────────────────────
# 서버 /home/dguard/dguard-kms/.env 파일 (권한 600)
# 이 파일을 .env 로 복사 후 실제 값으로 채울 것
# ─────────────────────────────────────────────

# Docker Hub 계정
DOCKER_USERNAME=your_dockerhub_username

# 배포 이미지 태그 (GitHub Actions에서 자동 주입)
IMAGE_TAG=latest

# PostgreSQL
DB_NAME=dguard_kms
DB_USER=dguard
DB_PASSWORD=change_me_strong_password

# 마스터 패스프레이즈 (UTF-8 32바이트 이상, 운영에서는 난수 사용)
KMS_MASTER_PASSPHRASE=replace_with_random_master_passphrase_32bytes

# 무결성 HMAC 키
INTEGRITY_HMAC_KEY=replace_with_random_integrity_key_32bytes

# JWT 시크릿
JWT_SECRET=replace_with_random_jwt_secret_32bytes

# DDL 전략 (초기: create, 이후: validate)
DDL_AUTO=create
